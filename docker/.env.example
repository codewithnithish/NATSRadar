# ==============================================================================
# NATSRadar & NATS Docker Environment Configuration
# Copy this file to .env before starting docker compose:
#   cp docker/.env.example docker/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# NATS Server Settings
# ------------------------------------------------------------------------------
# Client port exposed to the host machine
NATS_CLIENT_PORT=4222

# HTTP monitoring and Prometheus metrics port
NATS_MONITOR_PORT=8222

# JetStream storage directory inside container
NATS_STORE_DIR=/data

# JetStream RAM memory storage limit (e.g. 1G, 2G, 4G, 8G)
NATS_MAX_MEM=2G

# JetStream disk storage limit (e.g. 10G, 20G, 50G, 100G)
NATS_MAX_FILE=20G

# ------------------------------------------------------------------------------
# NATSRadar UI & API Settings
# ------------------------------------------------------------------------------
# Web UI port exposed to the host browser
NATSRADAR_PORT=8080

# Default NATS server URL NATSRadar connects to on boot
NATS_URL=nats://nats:4222

# Connection display name in the top navigation bar
NATSRADAR_DEFAULT_CONNECTION_NAME=Docker NATS

# Authentication settings
NATSRADAR_AUTH_ENABLED=true
NATSRADAR_AUTH_USER=admin
NATSRADAR_AUTH_PASS=admin@123

# Read-only mode: prevents publishing, purging, or deleting streams/keys
NATSRADAR_READ_ONLY=false

# Log level: debug, info, warn, error
NATSRADAR_LOG_LEVEL=info

